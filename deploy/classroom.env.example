# Add these to Vercel and the classroom worker. Keep existing DATABASE_URL,
# DIRECT_URL, AUTH_SECRET and BLOB_READ_WRITE_TOKEN; do not copy the local QA DB.
# Keep false until migrations and Zoom configuration are ready.
CLASSROOM_ENABLED="false"
APP_ORIGIN="https://we-win-vstep.vercel.app"
ZOOM_ACCOUNT_ID=""
ZOOM_OAUTH_CLIENT_ID=""
ZOOM_OAUTH_CLIENT_SECRET=""
ZOOM_MEETING_SDK_KEY=""
ZOOM_MEETING_SDK_SECRET=""
ZOOM_WEBHOOK_SECRET=""
# Explicit opt-in for Basic hosts on web deployments (maximum 40 minutes).
ZOOM_ALLOW_BASIC="false"
ZOOM_ALLOW_BASIC_LOCAL="false"
# Generate once: 32 random bytes in base64. Share the same value between web
# and worker; retain it to decrypt already-created meeting data.
DATA_ENCRYPTION_KEY=""
# Worker file scanning: internal ClamAV hostname, not a public URL.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
# Optional, only for the worker.
CLASSROOM_WORKER_ID="wewin-classroom-production"
# Optional separate service for sentence/paragraph translation in /tools.
GOOGLE_TRANSLATE_API_KEY=""
