# App connection string. In production use the Neon pooled URL.
DATABASE_URL="postgresql://wewin:wewin@localhost:5432/wewin?schema=public"
# Migration connection string. In production use Neon's direct (non-pooled) URL.
DIRECT_URL="postgresql://wewin:wewin@localhost:5432/wewin?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
BLOB_READ_WRITE_TOKEN=""
# Local mặc định sync; production phải dùng async cùng worker Speaking.
GRADING_MODE="sync"
SEED_DEMO_EMAIL="teacher.demo@wewin.local"
SEED_DEMO_PASSWORD="wewin-demo-change-me"
SEED_MANAGER_EMAIL=""
SEED_MANAGER_PASSWORD=""
OPENAI_API_KEY=""
OPENAI_GRADING_MODEL="gpt-4o-mini"
OPENAI_SPEAKING_MODEL="gpt-audio-1.5"
OPENAI_TRANSCRIPTION_MODEL="whisper-1"
OPENAI_VIDEO_MODEL="gpt-4o-mini"
# Google Cloud Translation API key for sentence/paragraph translation in /tools.
GOOGLE_TRANSLATE_API_KEY=""
# FFmpeg must be installed on the server; optional absolute executable path.
FFMPEG_PATH="ffmpeg"

# Online classes: keep disabled until the separate staging environment passes acceptance.
CLASSROOM_ENABLED="false"
APP_ORIGIN="http://localhost:3000"
ZOOM_ACCOUNT_ID=""
ZOOM_OAUTH_CLIENT_ID=""
ZOOM_OAUTH_CLIENT_SECRET=""
ZOOM_MEETING_SDK_KEY=""
ZOOM_MEETING_SDK_SECRET=""
ZOOM_WEBHOOK_SECRET=""
# Basic host testing: only accepted with the isolated localhost:5434/wewin_classroom_test DB.
ZOOM_ALLOW_BASIC_LOCAL="false"
# 32 random bytes encoded as base64, stable across web and worker.
DATA_ENCRYPTION_KEY=""
# Internal worker network only. Scanner failure never marks a file clean.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
CLASSROOM_WORKER_ID=""
