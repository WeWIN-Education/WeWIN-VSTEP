{
  "name": "wewin-education",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:roles": "node scripts/test-role-access.mjs",
    "grading:worker": "tsx scripts/process-grading-jobs.ts",
    "grading:worker:loop": "tsx scripts/process-grading-jobs.ts --loop",
    "grading:health": "tsx scripts/grading-health.ts",
    "storage:migrate": "tsx scripts/migrate-local-storage.ts",
    "cleanup:guest": "tsx scripts/cleanup-guest-sessions.ts",
    "postinstall": "prisma generate && node scripts/copy-zoom-assets.mjs",
    "classroom:worker": "node --conditions=react-server --import tsx scripts/process-classroom-jobs.ts --loop",
    "classroom:worker:once": "node --conditions=react-server --import tsx scripts/process-classroom-jobs.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@vercel/blob": "^2.8.0",
    "@zoom/meetingsdk": "6.5.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "file-type": "^21.3.4",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.12.3",
    "next": "^15.5.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "youtube-transcript-plus": "^2.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "prisma": "^6.16.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  }
}
